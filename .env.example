# Groq API Key for report classification & transcription
GROQ_API_KEY=

# Groq Model for classification (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Groq Fallback Models for classification when primary model hits rate limits (comma-separated)
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Groq Speech-to-Text Model (default: whisper-large-v3)
GROQ_STT_MODEL=whisper-large-v3

# Whisper STT prompt for Nigerian Pidgin / Lagos vocabulary
WHISPER_PROMPT="Nigerian Pidgin English. Common words: wetin, dey, na, di, wey, comot, abeg, pikin, oga, no wahala. Lagos places: Agege market, Mile 12 market, Ijegun, Oshodi, Ikorodu."

# Demo Mode (set to true to allow mock transcription fallback if STT fails)
DEMO_MODE=false

# Demo API key for advance, verify, seed, reset endpoints
DEMO_KEY=relay_demo_secret_key_2026

# Salt for hashing reporter identity (phone / WhatsApp ID)
REPORTER_SALT=relay_local_dev_salt_2026

# Seed database with initial demo data on boot if DB is empty
SEED_ON_EMPTY=true

# Node environment (development | production)
NODE_ENV=development

# Server Port
PORT=3000

# WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WEBHOOK_VERIFY_TOKEN=
# Meta App secret used to verify webhook signatures. REQUIRED in production (otherwise POST /webhook is refused).
WHATSAPP_APP_SECRET=
# Hosting on Vercel: see docs/DEPLOY_VERCEL.md
# DATABASE_PATH=/tmp/relay.db   (the only writable folder on Vercel; data there is temporary)
# HOSTED_READONLY=true          (hosted demo shows the sample cases but accepts no new reports)
